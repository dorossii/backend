FROM golang:1.26-bookworm as develop

# git とかの依存関係をインストールする
RUN apt update && \
    apt install curl wget git tzdata -y

ENV TZ=Asia/Tokyo

# 作業ディレクトリを設定
WORKDIR /app

# コンテナを止めないための設定
ENTRYPOINT [ "/bin/bash" ]

# ビルド用のコンテナ
FROM golang:1.26 as builder

ENV TZ=Asia/Tokyo

# 作業ディレクトリを設定
WORKDIR /go/src/app

# 依存関係をコピーする
COPY ./src .

# 依存関係をインストールする
RUN go mod download

# プロジェクトをビルドする (最適化ビルド)
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -trimpath -o /go/bin/app

# 実行用のコンテナ
FROM gcr.io/distroless/static-debian12 as release
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /go/bin/app /
# 管理画面(WebUI)の静的アセット(HTML/CSS/JS)を実行時カレントディレクトリにコピーする
COPY --from=builder /go/src/app/admin_ui /admin_ui
ENV TZ=Asia/Tokyo
CMD ["/app"]
